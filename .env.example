# Copy this file to .env and fill in your key -> cp .env.example .env
# Get a free key (no credit card) at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Model served by NIM (see README for alternatives)
NIM_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Hosted NIM endpoint. For air-gapped/local mode switch to Ollama:
#   NIM_BASE_URL=http://localhost:11434/v1
#   NIM_MODEL=qwen2.5:3b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Runner behaviour (optional)
HEADLESS=true
SLOW_MO=150
